# ---------------------------------------------------------------------------
# StockIQ India - example environment file
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#   1. Make a copy of it and name the copy exactly ".env"
#   2. Fill in the values you have. Blank values are fine - the app still runs.
#   3. NEVER commit the real .env file to Git. (.gitignore already blocks it.)
# ---------------------------------------------------------------------------

# --- Flask -----------------------------------------------------------------
# Used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# "development" turns on debug mode and auto-reload. Use "production" on a server.
FLASK_ENV=development

# Where the SQLite file lives. A RELATIVE path here is created inside Flask's
# "instance" folder, so this becomes  instance/stockiq.db  next to app.py.
# That folder is in .gitignore, so your database never reaches GitHub.
# For PostgreSQL later, just change this one line - no code changes needed:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stockiq
DATABASE_URL=sqlite:///stockiq.db


# --- Market data provider ---------------------------------------------------
# Which source the app uses for prices, financials and news.
#
#   demo      -> Built-in, offline, clearly-labelled DEMO DATA.
#                Safe default. Nothing is presented as real market data.
#   yfinance  -> Real historical/price data via the yfinance package.
#                You must "pip install yfinance" yourself and accept Yahoo's
#                terms of use. See README -> "Switching to real data".
#
DATA_PROVIDER=demo


# --- AI provider ------------------------------------------------------------
# The AI key is read ONLY by the Flask backend. It is never sent to the browser.
# Leave AI_API_KEY blank and the app falls back to a transparent, rule-based
# narrative generated from the numbers the backend already calculated.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5


# --- News provider (optional) ----------------------------------------------
# If you have a NewsAPI.org key, put it here to fetch real headlines.
# Leave it blank to use the demo news feed (clearly labelled).
NEWS_API_KEY=


# --- Caching ----------------------------------------------------------------
# How long (in seconds) each kind of data is reused before we fetch it again.
CACHE_TTL_PRICE=60          # 1 minute   - prices move constantly
CACHE_TTL_HISTORY=900       # 15 minutes - historical candles
CACHE_TTL_FINANCIALS=86400  # 24 hours   - annual reports change rarely
CACHE_TTL_NEWS=900          # 15 minutes - news
CACHE_TTL_COMPANY=604800    # 7 days     - company profile / sector
CACHE_TTL_AI=3600           # 1 hour     - AI narratives (they cost money)
